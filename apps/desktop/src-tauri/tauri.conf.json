{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meiki",
  "version": "0.1.0",
  "identifier": "jp.meiki.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "明記",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 560
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      },
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
