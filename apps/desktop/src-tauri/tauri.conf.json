{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meiki",
  "version": "0.2.0",
  "identifier": "jp.meiki.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "明記",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 560
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      },
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Local-first typed-cloze learning",
    "longDescription": "Meiki is a personal, network-free desktop application for language-neutral typed-cloze recall.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
