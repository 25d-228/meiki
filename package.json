{
  "name": "meiki-workspace",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "bindings": "cargo run -p meiki-application --bin export-bindings",
    "boundaries": "python scripts/check-boundaries.py",
    "build": "npm run build --workspace @meiki/desktop",
    "cargo:format": "cargo fmt --all --check",
    "cargo:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "cargo:test": "cargo test --workspace",
    "e2e": "npm run e2e --workspace @meiki/desktop",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && npm run cargo:format",
    "lint": "eslint . && npm run cargo:lint",
    "performance": "./scripts/performance",
    "release:check": "python scripts/check-release.py",
    "release:check:test": "python scripts/test_check_release.py",
    "test": "npm run test:unit --workspace @meiki/desktop && npm run cargo:test",
    "typecheck": "npm run check --workspace @meiki/desktop",
    "verify": "npm run audit && npm run bindings && npm run boundaries && npm run release:check && npm run release:check:test && npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test && npm run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "typescript-eslint": "^8.65.0"
  }
}
